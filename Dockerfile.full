FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    gnupg \
    wget \
    tar \
    build-essential \
    pkg-config \
    libffi-dev \
    libssl-dev \
    ffmpeg \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

RUN npm install -g openclaw@latest

RUN mkdir -p /charm_cache/skills && chmod 777 /charm_cache/skills \
    && mkdir -p /root/.openclaw/workspace && chmod 777 /root/.openclaw

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:/opt/openclaw/bin:$PATH"
ENV UV_CACHE_DIR=/root/.cache/uv

RUN uv venv $VIRTUAL_ENV

RUN uv pip install \
    "crewai[tools]>=0.28.0" \
    "langchain>=0.1.0" \
    "langgraph>=0.0.26" \
    "openai>=1.10.0" \
    "google-generativeai" \
    "langchain-google-genai" \
    "pydantic>=2.0.0" \
    "pandas>=2.0.0" \
    "numpy>=1.24.0" \
    "scipy>=1.10.0" \
    "requests" \
    "beautifulsoup4" \
    "tiktoken" \
    "python-dotenv" \
    "google-cloud-run" \
    "google-cloud-logging"


RUN uv pip install "mcp"

COPY pyproject.toml .
RUN uv pip install -r pyproject.toml

COPY src /app/src
RUN uv pip install --no-deps -e .

CMD ["echo", "Charm Full Runtime (Python + Node + OpenClaw) Ready"]
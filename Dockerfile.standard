FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    tar \
    build-essential \
    pkg-config \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libxml2-dev \
    libxslt-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV UV_CACHE_DIR=/root/.cache/uv

RUN uv venv $VIRTUAL_ENV

RUN uv pip install \
    "crewai[tools]>=0.28.0" \
    "langchain>=0.1.0" \
    "langgraph>=0.0.26" \
    "openai>=1.10.0" \
    "google-generativeai" \
    "langchain-google-genai" \
    "pydantic>=2.0.0" \
    "pandas>=2.0.0" \
    "numpy>=1.24.0" \
    "scipy>=1.10.0" \
    "requests" \
    "beautifulsoup4" \
    "tiktoken" \
    "python-dotenv" \
    "google-cloud-run" \
    "google-cloud-logging"

COPY pyproject.toml .
RUN uv pip install -r pyproject.toml

COPY src /app/src
RUN uv pip install --no-deps -e .

CMD ["echo", "Charm Python Runtime Ready"]

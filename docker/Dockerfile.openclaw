FROM ucmind/charm-base:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libnss3 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

RUN npm install -g openclaw@latest

RUN mkdir -p /charm_cache/skills && chmod 777 /charm_cache/skills \
    && mkdir -p /root/.openclaw/workspace && chmod 777 /root/.openclaw

ENV PATH="/opt/openclaw/bin:$PATH"

RUN uv pip install -e ".[openclaw]" \
    "pandas>=2.0.0" \
    "numpy>=1.24.0"

CMD ["echo", "Charm OpenClaw Runtime Ready"]

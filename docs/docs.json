                            "templates/python",
                            "templates/research",
                            "templates/code-review",
                            "templates/customer-support",
                            "templates/data-pipeline",
                            "templates/slack-bot",
                            "templates/openclaw",
                            "templates/hermes",
                            "templates/interactive",
                            "templates/daemon",
                            "templates/oauth-integration"
                        ]
                    }

{
    "theme": "mint",
    "name": "Charm Docs",
    "variables": {
        "store_url": "https://store.charmos.io",
        "api_base_url": "https://store.charmos.io/api",
        "discord_url": "https://discord.gg/gdakynHUEb",
        "cli_package": "charmos",
        "manifest_version": "0.4.2"
    },
    "favicon": "/assets/logo.png",
    "logo": {
        "light": "/assets/logo.png",
        "dark": "/assets/logo.png"
    },
    "colors": {
        "primary": "#E8A694",
        "light": "#FFF5EE",
        "dark": "#E8A694"
    },
    "fonts": {
        "body": {
            "family": "Space Grotesk"
        },
        "heading": {
            "family": "JetBrains Mono"
        }
    },
    "styling": {
        "codeblocks": {
            "theme": {
                "dark": "min-dark",
                "light": "min-light"
            }
        }
    },
    "navbar": {
        "links": [
            {
                "label": "GitHub",
                "icon": "github",
                "href": "https://github.com/CharmAIOS/Charm"
            },
            {
                "label": "Changelog",
                "icon": "box",
                "href": "https://charmos.io/changelog"
            },
            {
                "label": "Discord",
                "icon": "discord",
                "href": "https://discord.gg/gdakynHUEb"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Charm Store",
            "href": "https://store.charmos.io"
        }
    },
    "redirects": [],
    "navigation": {
        "tabs": [
            {
                "tab": "Get Started",
                "groups": [
                    {
                        "group": " ",
                        "pages": [
                            "index",
                            "quickstart/overview",
                            "quickstart/install",
                            "quickstart/first-app",
                            "quickstart/publish",
                            "guides/onboarding"
                        ]
                    },
                    {

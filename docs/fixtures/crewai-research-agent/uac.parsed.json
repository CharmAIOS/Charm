            "agent": "project_analyst"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "project_analyst",
        "to": "analysis_task"
      }
    ],
    "entry": "project_analyst",
    "exits": ["analysis_task"]
  },
  "x-source": {
    "framework": "CrewAI",
    "origin_file": "agents.py"
  }

{
  "$defs": {
    "AuthConfig": {
      "description": "Global authentication requirements for the agent.",
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/AuthProvider"
          },
          "title": "Providers",
          "type": "array"
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "AuthProvider": {
      "description": "Configuration for OAuth requirements.",
      "properties": {
        "name": {
          "description": "Provider name (e.g. 'google', 'github', 'twitter')",
          "title": "Name",
          "type": "string"
        },
        "scopes": {
          "description": "List of required OAuth scopes",
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "AuthProvider",
      "type": "object"
    },
    "EnvVars": {
      "description": "Environment variables split logically to support backend validation flows.",
      "properties": {
        "models": {
          "description": "LLM/Model API keys",
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "tools": {
          "description": "Tool/Skill API keys",
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "EnvVars",
      "type": "object"
    },
    "HumanInTheLoop": {
      "description": "Configuration for human oversight.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "triggers": {
          "description": "Keywords or tool names that trigger approval",
          "items": {
            "type": "string"
          },
          "title": "Triggers",
          "type": "array"
        }
      },
      "title": "HumanInTheLoop",
      "type": "object"
    },
    "InterfaceConfig": {
      "description": "Defines Inputs, Outputs, and State structure.",
      "properties": {
        "input": {
          "additionalProperties": true,
          "description": "JSON Schema for input parameters",
          "title": "Input",
          "type": "object"
        },
        "output": {
          "additionalProperties": true,
          "description": "JSON Schema for output format",
          "title": "Output",
          "type": "object"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterfaceState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ui": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UI schema for dynamic form rendering",
          "title": "Ui"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "InterfaceConfig",
      "type": "object"
    },
    "InterfaceState": {
      "description": "Schema of the persistent state.",
      "properties": {
        "format": {
          "default": "json",
          "enum": [
            "json",
            "binary",
            "pydantic_model"
          ],
          "title": "Format",
          "type": "string"
        },
        "schema": {
          "additionalProperties": true,
          "description": "Structure of the state object",
          "title": "Schema",
          "type": "object"
        }
      },
      "title": "InterfaceState",
      "type": "object"
    },
    "MemoryConfig": {
      "description": "Configuration for the state/memory storage plugin.",
      "properties": {
        "provider": {
          "default": "local",
          "description": "The memory provider plugin name (e.g., 'local', 'redis', 'postgres').",
          "title": "Provider",
          "type": "string"
        },
        "config": {
          "additionalProperties": true,
          "description": "Provider-specific configuration (e.g., connection URLs).",
          "title": "Config",
          "type": "object"
        }
      },
      "title": "MemoryConfig",
      "type": "object"
    },
    "OpenClawConfig": {
      "description": "Configuration specific to the OpenClaw runtime engine.",
      "properties": {
        "system_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The core personality or instruction set for the agent (writes to IDENTITY.md).",
          "title": "System Prompt"
        },
        "model": {
          "default": "gpt-4o",
          "description": "The LLM model ID to use (e.g. gpt-4o, claude-3-5-sonnet).",
          "title": "Model",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "description": "LLM sampling temperature.",
          "title": "Temperature",
          "type": "number"
        },
        "auto_install_dependencies": {
          "default": true,
          "description": "If True, recursively installs requirements.txt/package.json found in local skills.",
          "title": "Auto Install Dependencies",
          "type": "boolean"
        }
      },
      "title": "OpenClawConfig",
      "type": "object"
    },
    "Persona": {
      "description": "Identity and metadata for Store display and Search.",
      "properties": {
        "name": {
          "description": "The public name of the agent shown in the store",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "0.1.0",
          "description": "Semantic version (e.g. 1.0.0)",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "description": {
          "description": "Short tagline for card view (max 100 chars)",
          "title": "Description",
          "type": "string"
        },
        "full_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Long markdown description for the detail page",
          "title": "Full Description"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "license": {
          "default": "Free",
          "description": "Usage license (e.g. 'Proprietary', 'MIT')",
          "title": "License",
          "type": "string"
        },
        "assets": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoreAssets"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "Persona",
      "type": "object"
    },
    "Policies": {
      "description": "Governance and safety rules.",
      "properties": {
        "allow_internet_access": {
          "default": true,
          "title": "Allow Internet Access",
          "type": "boolean"
        },
        "human_in_the_loop": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanInTheLoop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_steps": {
          "default": 20,
          "description": "Max execution steps",
          "title": "Max Steps",
          "type": "integer"
        },
        "budget_limit": {
          "default": 0.0,
          "description": "Max USD cost per run",
          "title": "Budget Limit",
          "type": "number"
        },
        "execution_timeout_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional serverless execution timeout override in seconds.",
          "title": "Execution Timeout Seconds"
        }
      },
      "title": "Policies",
      "type": "object"
    },
    "Pricing": {
      "description": "Commercial model for the Charm Store.",
      "properties": {
        "model": {
          "default": "free",
          "enum": [
            "free",
            "subscription",
            "one_time"
          ],
          "title": "Model",
          "type": "string"
        },
        "amount": {
          "default": 0.0,
          "description": "Price in USD",
          "title": "Amount",
          "type": "number"
        },
        "billing_period": {
          "anyOf": [
            {
              "enum": [
                "monthly",
                "annual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Period"
        },
        "trial": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrialConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Pricing",
      "type": "object"
    },
    "RuntimeAdapter": {
      "description": "Instructs the Loader how to bootstrap this agent.",
      "properties": {
        "type": {
          "description": "The specific SDK adapter to use",
          "title": "Type",
          "type": "string"
        },
        "entry_point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Python import path (src.main:app) OR Shell command. Optional for 'openclaw'.",
          "title": "Entry Point"
        },
        "environment_variables": {
          "$ref": "#/$defs/EnvVars",
          "description": "Required env vars to be injected"
        }
      },
      "required": [
        "type"
      ],
      "title": "RuntimeAdapter",
      "type": "object"
    },
    "RuntimeConfig": {
      "properties": {
        "adapter": {
          "$ref": "#/$defs/RuntimeAdapter"
        },
        "skills": {
          "description": "List of MCP Skills to mount.",
          "items": {
            "$ref": "#/$defs/SkillConfig"
          },
          "title": "Skills",
          "type": "array"
        },
        "telemetry": {
          "description": "List of telemetry exporter names to enable.",
          "items": {
            "type": "string"
          },
          "title": "Telemetry",
          "type": "array"
        },
        "memory": {
          "$ref": "#/$defs/MemoryConfig",
          "description": "Configuration for persistent memory and state storage."
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenClawConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Engine-specific configuration (e.g. for OpenClaw)."
        },
        "custom_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom Docker image URI for the runtime environment.",
          "title": "Custom Image"
        },
        "mode": {
          "default": "standard",
          "description": "Select 'full' if you need Browser(Chrome), FFmpeg, or Node.js runtime. (Deprecated)",
          "enum": [
            "standard",
            "full"
          ],
          "title": "Mode",
          "type": "string"
        },
        "lifecycle": {
          "default": "serverless",
          "description": "Execution mode: 'serverless' (max 10 mins), 'daemon' (24/7 always-on), or 'interactive' (real-time streaming).",
          "enum": [
            "serverless",
            "daemon",
            "interactive"
          ],
          "title": "Lifecycle",
          "type": "string"
        }
      },
      "required": [
        "adapter"
      ],
      "title": "RuntimeConfig",
      "type": "object"
    },
    "SkillConfig": {
      "description": "Configuration for an external Skill/MCP Server.",
      "properties": {
        "name": {
          "description": "Unique identifier for the skill (e.g. 'google-search')",
          "title": "Name",
          "type": "string"
        },
        "source": {
          "description": "Source: 'smithery:@org/pkg', 'git:https://...', 'pip:package', or 'local:./path'",
          "title": "Source",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific version or commit hash",
          "title": "Version"
        },
        "config": {
          "additionalProperties": true,
          "description": "Environment variables or config overrides for this skill",
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "SkillConfig",
      "type": "object"
    },
    "StoreAssets": {
      "description": "Visual assets for the Storefront.",
      "properties": {
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to square icon (512x512)",
          "title": "Icon"
        },
        "banner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL to wide banner image",
          "title": "Banner"
        },
        "screenshots": {
          "description": "List of screenshot URLs",
          "items": {
            "type": "string"
          },
          "title": "Screenshots",
          "type": "array"
        }
      },
      "title": "StoreAssets",
      "type": "object"
    },
    "TrialConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "days": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        }
      },
      "title": "TrialConfig",
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "description": "Contract version (Compatible with 0.4.x SDK)",
      "pattern": "^0\\.4(\\.\\d+)?$",
      "title": "Version",
      "type": "string"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Unique UUID for the agent. Generated by CLI.",
      "title": "Id"
    },
    "persona": {
      "$ref": "#/$defs/Persona"
    },
    "pricing": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pricing"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "goals": {
      "description": "Semantic goals for search indexing",
      "items": {
        "type": "string"
      },
      "title": "Goals",
      "type": "array"
    },
    "interface": {
      "$ref": "#/$defs/InterfaceConfig"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig"
    },
    "policies": {
      "anyOf": [
        {
          "$ref": "#/$defs/Policies"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workflow": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow"
    }
  },
  "required": [
    "version",
    "persona",
    "interface",
    "runtime"
  ],
  "title": "CharmConfig",
  "type": "object",
  "$id": "https://charm.ai/contracts/uac.v0.4.2.schema.json"
}
